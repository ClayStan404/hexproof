 public abstract class PlayerController {
 
+    /** Abandons a decision only after its player and controlling object left the game. */
+    public static final class PlayerDecisionCancelled extends java.util.concurrent.CancellationException {
+        private final Player player;
+        private final SpellAbility ability;
+
+        public PlayerDecisionCancelled(Player player, SpellAbility ability) {
+            super("The deciding player left the game");
+            if (player == null || player.isInGame() || ability == null) {
+                throw new IllegalArgumentException("Only a departed player's object decision can be abandoned");
+            }
+            this.player = player;
+            this.ability = ability;
+        }
+
+        public boolean canAbandon(SpellAbility current) {
+            if (player.isInGame() || current == null || current.getHostCard().getGame() != player.getGame()) {
+                return false;
+            }
+            // CR 800.4a removes every spell/ability controlled by the departing player.
+            // Replacement abilities of their departed permanents cease with the object.
+            return ability.getActivatingPlayer() == player && current.getActivatingPlayer() == player
+                || ability.getRootAbility().isSpell() && ability.getHostCard().getOwner() == player
+                    && current.getRootAbility() == ability.getRootAbility()
+                || ability == current && current.isReplacementAbility() && current.getHostCard().getOwner() == player;
+        }
+    }
+
+    /** CR 800.4g: the object's controller explicitly chooses the replacement. */
+    public final Player choosePlayerForDepartedDecision(SpellAbility ability, Player departed) {
+        if (departed.isInGame() || !player.isInGame() || ability.getActivatingPlayer() != player) {
+            throw new IllegalArgumentException("A departed player's choice requires its surviving object controller");
+        }
+        while (player.isInGame()) {
+            forge.util.collect.FCollection<Player> choices = new forge.util.collect.FCollection<>(getGame().getPlayers());
+            if (departed.isOpponentOf(player)) {
+                forge.util.collect.FCollection<Player> opponents = new forge.util.collect.FCollection<>();
+                for (Player candidate : choices) {
+                    if (candidate.isOpponentOf(player)) { opponents.add(candidate); }
+                }
+                if (!opponents.isEmpty()) { choices = opponents; }
+            }
+            Player chosen = chooseSingleEntityForEffect(choices, ability,
+                    "Choose a player to make the departed player's choice", Map.of());
+            if (player.isInGame() && chosen != null && chosen.isInGame()) { return chosen; }
+            // A candidate can leave while the native choice is open. Ask again
+            // from the surviving set rather than continuing with that player.
+        }
+        throw new PlayerDecisionCancelled(player, ability);
+    }
