# Manabrew supplies the maintained headless Forge harness. Its forge gitlink is
# verified separately so a rewritten or incomplete checkout cannot silently
# combine mismatched Java classes and card scripts.
MANABREW_REPOSITORY=https://github.com/witchesofthehill/manabrew.git
MANABREW_REVISION=143a6b556ac365cea97929ffcebb48eed03ecde8
FORGE_REVISION=753b3dd544d6f02061d796ff7a0b54806631edcb
# Increment whenever the downstream runtime patches change behavior.
HEXPROOF_FORGE_PATCH_REVISION=2
