{
  "schemaVersion": 1,
  "protocol": "hexproof.v1",
  "definitions": [
    {
      "name": "RulesStartFailure", "goType": "RulesStartFailure", "fields": [
        {"name": "reason", "type": "string", "required": true, "enum": ["RulesStartReasonDeckRejected", "RulesStartReasonCapacity", "RulesStartReasonRuntimeUnavailable", "RulesStartReasonRuntimeTimeout", "RulesStartReasonRuntimeFailed", "RulesStartReasonStartRejected"]},
        {"name": "issues", "type": "array", "required": false, "items": {"type": "object", "ref": "RulesDeckIssue"}},
        {"name": "truncated", "type": "boolean", "required": false}
      ]
    },
    {
      "name": "RulesDeckIssue", "goType": "RulesDeckIssue", "fields": [
        {"name": "deck", "type": "string", "required": true, "enum": ["RulesDeckOwnerPlayer", "RulesDeckOwnerAI"]},
        {"name": "section", "type": "string", "required": true, "enum": ["SideboardZoneMain", "SideboardZoneSide", "RulesDeckSectionCommanders"]},
        {"name": "code", "type": "string", "required": true, "enum": ["RulesDeckIssueCardUnavailable", "RulesDeckIssuePrintingUnavailable", "RulesDeckIssueCommanderMissing", "RulesDeckIssueInvalidDeckSize", "RulesDeckIssueInvalidSideboardSize"]},
        {"name": "cardName", "type": "string", "required": false},
        {"name": "setCode", "type": "string", "required": false},
        {"name": "collectorNumber", "type": "string", "required": false}
      ]
    },
    {"name": "ForgeHostStatus", "goType": "ForgeHostStatus", "fields": [{"name": "roomId", "type": "string", "required": true}, {"name": "connected", "type": "boolean", "required": true}, {"name": "graceSeconds", "type": "integer", "required": true}, {"name": "hostSeat", "type": "integer", "required": true}, {"name": "backupSeat", "type": "integer", "required": false, "goType": "*int"}, {"name": "backupConnected", "type": "boolean", "required": false}, {"name": "backupApproved", "type": "boolean", "required": false}, {"name": "migrating", "type": "boolean", "required": false}, {"name": "migrationAvailable", "type": "boolean", "required": false}, {"name": "migrationError", "type": "string", "required": false}]},
    {
      "name": "RoomListEntry",
      "goType": "RoomListEntry",
      "fields": [
        {"name": "roomId", "type": "string", "required": true},
        {"name": "roomKind", "type": "string", "required": false},
        {"name": "name", "type": "string", "required": true},
        {"name": "format", "type": "string", "required": true, "enum": ["FormatModern", "FormatDuel", "FormatEDH"]},
        {"name": "deckFormat", "type": "string", "required": true, "enum": ["DeckFormatCustom", "DeckFormatStandard", "DeckFormatPioneer", "DeckFormatModern", "DeckFormatLegacy", "DeckFormatVintage", "DeckFormatPauper", "DeckFormatDuel", "DeckFormatCommander", "DeckFormatCube"]},
        {"name": "matchMode", "type": "string", "required": true, "enum": ["MatchBO1", "MatchBO3"]},
        {"name": "cardLoadMode", "type": "string", "required": true, "enum": ["CardLoadPreload", "CardLoadBackground"]},
        {"name": "rulesMode", "type": "string", "required": true, "enum": ["RulesModeManual", "RulesModeForge"]},
        {"name": "hostingMode", "type": "string", "required": false, "enum": ["HostingModeServer", "HostingModePlayer"]},
        {"name": "aiSource", "type": "string", "required": false, "enum": ["AISourceForge", "AISourceLocal", "AISourceOnline"]},
        {"name": "aiDifficulty", "type": "string", "required": false, "enum": ["AIDifficultyEasy", "AIDifficultyNormal", "AIDifficultyHard"]},
        {"name": "maxSeats", "type": "integer", "required": true},
        {"name": "playerCount", "type": "integer", "required": true},
        {"name": "spectatorCount", "type": "integer", "required": true},
        {"name": "allowSpectators", "type": "boolean", "required": true},
        {"name": "spectatorsSeeHands", "type": "boolean", "required": true},
        {"name": "hasPassword", "type": "boolean", "required": true},
        {"name": "phase", "type": "string", "required": true, "enum": ["RoomPhaseWaiting", "RoomPhaseLoading", "RoomPhaseStarted", "LimitedStageDraft", "LimitedStageDeckBuilding", "RoomPhaseFreePlay"]},
        {"name": "playerJoinable", "type": "boolean", "required": true},
        {"name": "spectatorJoinable", "type": "boolean", "required": true}
      ]
    }
  ],
  "messages": [
    {"type": "room.ai.configure", "direction": "clientToServer", "goType": "RoomAIConfigure", "fields": [
      {"name": "difficulty", "type": "string", "required": false, "enum": ["AIDifficultyEasy", "AIDifficultyNormal", "AIDifficultyHard"]},
      {"name": "deck", "type": "object", "required": false, "goType": "*DeckSelect", "ref": "DeckSelect"}
    ]},
    {"type": "forge.peer_request", "direction": "clientToServer", "goType": "ForgePeerRequest", "fields": [{"name": "enabled", "type": "boolean", "required": true}, {"name": "retry", "type": "boolean", "required": false}]},
    {"type": "forge.peer_grant", "direction": "serverToClient", "goType": "ForgePeerGrant", "fields": [{"name": "roomId", "type": "string", "required": true}, {"name": "gameId", "type": "string", "required": true}, {"name": "bindingId", "type": "string", "required": true}, {"name": "token", "type": "string", "required": true}, {"name": "hostSeat", "type": "integer", "required": true}, {"name": "offerer", "type": "boolean", "required": true}, {"name": "stun", "type": "array", "required": true, "items": {"type": "string"}}]},
    {"type": "forge.peer_signal", "direction": "clientToServer", "goType": "ForgePeerSignal", "fields": [{"name": "roomId", "type": "string", "required": true}, {"name": "bindingId", "type": "string", "required": true}, {"name": "data", "type": "string", "required": true}]},
    {"type": "forge.peer_signaled", "direction": "serverToClient", "goType": "ForgePeerSignal", "fields": [{"name": "roomId", "type": "string", "required": true}, {"name": "bindingId", "type": "string", "required": true}, {"name": "data", "type": "string", "required": true}]},
    {"type": "forge.peer_status", "direction": "serverToClient", "goType": "ForgePeerStatus", "fields": [{"name": "bindingId", "type": "string", "required": true}, {"name": "roomId", "type": "string", "required": true}, {"name": "enabled", "type": "boolean", "required": true}, {"name": "otherEnabled", "type": "boolean", "required": true}, {"name": "available", "type": "boolean", "required": true}]},
    {"type": "session.ping", "direction": "clientToServer", "goType": "EmptyPayload", "fields": []},
    {"type": "session.pong", "direction": "serverToClient", "goType": "EmptyPayload", "fields": []},
    {
      "type": "room.leave",
      "direction": "clientToServer",
      "goType": "EmptyPayload",
      "fields": [],
      "qtBuilder": {"file": "apps/client-qt/src/services/WsClientCommands.cpp", "function": "WsClient::leaveRoom"}
    },
    {
      "type": "room.left",
      "direction": "serverToClient",
      "goType": "RoomLeft",
      "fields": [{"name": "roomId", "type": "string", "required": true}]
    },
    {
      "type": "room.kick",
      "direction": "clientToServer",
      "goType": "RoomKick",
      "fields": [
        {"name": "seat", "type": "integer", "required": false, "goType": "*int"},
        {"name": "spectatorIndex", "type": "integer", "required": false, "goType": "*int"}
      ]
    },
    {
      "type": "room.kicked",
      "direction": "serverToClient",
      "goType": "RoomLeft",
      "fields": [{"name": "roomId", "type": "string", "required": true}]
    },
    {
      "type": "room.disband",
      "direction": "clientToServer",
      "goType": "EmptyPayload",
      "fields": [],
      "qtBuilder": {"file": "apps/client-qt/src/services/WsClientCommands.cpp", "function": "WsClient::disbandRoom"}
    },
    {
      "type": "room.disbanded",
      "direction": "serverToClient",
      "goType": "RoomLeft",
      "fields": [{"name": "roomId", "type": "string", "required": true}]
    },
    {
      "type": "room.list",
      "direction": "clientToServer",
      "goType": "EmptyPayload",
      "fields": [],
      "qtBuilder": {"file": "apps/client-qt/src/services/WsClientCommands.cpp", "function": "WsClient::requestRoomList"}
    },
    {
      "type": "room.listed",
      "direction": "serverToClient",
      "goType": "RoomListed",
      "fields": [
        {"name": "rooms", "type": "array", "required": true, "items": {"type": "object", "ref": "RoomListEntry"}}
      ]
    },
    {
      "type": "error",
      "direction": "serverToClient",
      "goType": "ErrorPayload",
      "fields": [
        {
          "name": "code",
          "type": "string",
          "required": true,
          "enum": [
            "ErrPlayerHostTrustRequired", "ErrWrongPassword", "ErrRoomFull", "ErrRoomNotFound", "ErrSpectatorsNotAllowed",
            "ErrSpectatorLimit", "ErrAlreadyInRoom", "ErrNotHost", "ErrNotInRoom",
            "ErrInvalidMessage", "ErrNameRequired", "ErrUnsupportedFormat", "ErrInvalidTarget",
            "ErrCannotKickHost", "ErrInvalidMatchMode", "ErrInvalidCardLoadMode", "ErrNotPlayer",
            "ErrInvalidDeck", "ErrDeckRequired", "ErrSeatsNotFilled", "ErrNotLoading",
            "ErrStaleLoad", "ErrMatchStarted", "ErrGameNotStarted", "ErrGameFinished",
            "ErrMatchNotFinished", "ErrLibraryEmpty", "ErrGameSetupFailed", "ErrInvalidZone",
            "ErrCardNotFound", "ErrInvalidPosition", "ErrInvalidMove", "ErrInvalidPhase",
            "ErrNotActivePlayer", "ErrInvalidCounter", "ErrInvalidChat", "ErrInvalidToken",
            "ErrPlayerEliminated", "ErrNotSideboarding", "ErrInvalidSideboardMove",
            "ErrSideboardNotExpired", "ErrServerLimit", "ErrRateLimited", "ErrReplayNotFound",
            "ErrInternal", "ErrPermissionDenied", "ErrApprovalRequired", "ErrApprovalPending",
            "ErrApprovalExpired", "ErrClientVersionMismatch", "ErrTournamentInvalid",
            "ErrTournamentForbidden", "ErrTournamentNotFound", "ErrTournamentFull",
            "ErrTournamentAlreadyRegistered", "ErrTournamentRegistrationClosed",
            "ErrTournamentNotReady", "ErrTournamentRoundIncomplete",
            "ErrTournamentResultInvalid", "ErrInvalidRulesMode", "ErrRulesUnavailable"
          ]
        },
        {"name": "message", "type": "string", "required": true},
        {"name": "clientVersion", "type": "string", "required": false},
        {"name": "requiredVersion", "type": "string", "required": false},
        {"name": "minimumPlayers", "type": "integer", "required": false},
        {"name": "rulesStartFailure", "type": "object", "required": false, "goType": "*RulesStartFailure", "ref": "RulesStartFailure"}
      ]
    },
    {"type": "forge.host_request", "direction": "clientToServer", "goType": "ForgeHostRequest", "fields": [{"name": "action", "type": "string", "required": false}]},
    {"type": "forge.host_grant", "direction": "serverToClient", "goType": "ForgeHostGrant", "fields": [{"name": "roomId", "type": "string", "required": true}, {"name": "token", "type": "string", "required": true}, {"name": "runtimeId", "type": "string", "required": true}, {"name": "graceSeconds", "type": "integer", "required": true}, {"name": "standby", "type": "boolean", "required": false}]},
    {"type": "forge.host_status", "direction": "serverToClient", "goType": "ForgeHostStatus", "fields": [{"name": "roomId", "type": "string", "required": true}, {"name": "connected", "type": "boolean", "required": true}, {"name": "graceSeconds", "type": "integer", "required": true}, {"name": "hostSeat", "type": "integer", "required": true}, {"name": "backupSeat", "type": "integer", "required": false, "goType": "*int"}, {"name": "backupConnected", "type": "boolean", "required": false}, {"name": "backupApproved", "type": "boolean", "required": false}, {"name": "migrating", "type": "boolean", "required": false}, {"name": "migrationAvailable", "type": "boolean", "required": false}, {"name": "migrationError", "type": "string", "required": false}]}
  ]
}
