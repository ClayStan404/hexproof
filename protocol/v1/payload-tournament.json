    {
      "type": "tournament.check_in_set",
      "direction": "serverToClient",
      "goType": "TournamentChanged",
      "fields": [{"name": "tournamentId", "type": "string", "required": true}]
    },
    {"type": "tournament.start", "direction": "clientToServer", "goType": "EmptyPayload", "fields": []},
    {"type": "tournament.started", "direction": "serverToClient", "goType": "TournamentChanged", "fields": [{"name": "tournamentId", "type": "string", "required": true}]},
    {"type": "tournament.drop", "direction": "clientToServer", "goType": "TournamentParticipantCommand", "fields": [{"name": "participantId", "type": "string", "required": false}]},
    {"type": "tournament.dropped", "direction": "serverToClient", "goType": "TournamentChanged", "fields": [{"name": "tournamentId", "type": "string", "required": true}]},
    {
      "type": "tournament.report_result",
      "direction": "clientToServer",
      "goType": "TournamentResultCommand",
      "fields": [
        {"name": "pairingId", "type": "string", "required": true},
        {"name": "playerAWins", "type": "integer", "required": true},
        {"name": "playerBWins", "type": "integer", "required": true},
        {"name": "drawnGames", "type": "integer", "required": true}
      ]
    },
    {"type": "tournament.result_reported", "direction": "serverToClient", "goType": "TournamentChanged", "fields": [{"name": "tournamentId", "type": "string", "required": true}]},
    {"type": "tournament.confirm_result", "direction": "clientToServer", "goType": "TournamentPairingCommand", "fields": [{"name": "pairingId", "type": "string", "required": true}]},
    {"type": "tournament.result_confirmed", "direction": "serverToClient", "goType": "TournamentChanged", "fields": [{"name": "tournamentId", "type": "string", "required": true}]},
    {"type": "tournament.reject_result", "direction": "clientToServer", "goType": "TournamentPairingCommand", "fields": [{"name": "pairingId", "type": "string", "required": true}]},
    {"type": "tournament.result_rejected", "direction": "serverToClient", "goType": "TournamentChanged", "fields": [{"name": "tournamentId", "type": "string", "required": true}]},
    {
      "type": "tournament.correct_result",
      "direction": "clientToServer",
      "goType": "TournamentResultCommand",
      "fields": [
        {"name": "pairingId", "type": "string", "required": true},
        {"name": "playerAWins", "type": "integer", "required": true},
        {"name": "playerBWins", "type": "integer", "required": true},
        {"name": "drawnGames", "type": "integer", "required": true}
      ]
    },
    {"type": "tournament.result_corrected", "direction": "serverToClient", "goType": "TournamentChanged", "fields": [{"name": "tournamentId", "type": "string", "required": true}]},
    {"type": "tournament.next_round", "direction": "clientToServer", "goType": "EmptyPayload", "fields": []},
    {"type": "tournament.round_started", "direction": "serverToClient", "goType": "TournamentChanged", "fields": [{"name": "tournamentId", "type": "string", "required": true}]},
    {"type": "tournament.open_match", "direction": "clientToServer", "goType": "TournamentPairingCommand", "fields": [{"name": "pairingId", "type": "string", "required": true}]},
    {
      "type": "tournament.match_opened",
      "direction": "serverToClient",
      "goType": "TournamentMatchOpened",
      "fields": [
        {"name": "tournamentId", "type": "string", "required": true},
        {"name": "pairingId", "type": "string", "required": true},
        {"name": "roomId", "type": "string", "required": true}
      ]
    },
    {"type": "tournament.cancel", "direction": "clientToServer", "goType": "EmptyPayload", "fields": []},
    {"type": "tournament.cancelled", "direction": "serverToClient", "goType": "TournamentChanged", "fields": [{"name": "tournamentId", "type": "string", "required": true}]},
    {
      "type": "tournament.snapshot",
      "direction": "serverToClient",
      "goType": "TournamentSnapshot",
      "fields": [
        {"name": "tournamentId", "type": "string", "required": true},
        {"name": "name", "type": "string", "required": true},
        {"name": "format", "type": "string", "required": true},
        {"name": "matchMode", "type": "string", "required": true, "enum": ["MatchBO1", "MatchBO3"]},
        {"name": "status", "type": "string", "required": true},
        {"name": "roundMinutes", "type": "integer", "required": true},
        {"name": "roundStartedAt", "type": "string", "required": false},
        {"name": "maxPlayers", "type": "integer", "required": true},
        {"name": "plannedRounds", "type": "integer", "required": true},
        {"name": "currentRound", "type": "integer", "required": true},
        {"name": "registered", "type": "integer", "required": true},
        {"name": "checkedIn", "type": "integer", "required": true},
        {"name": "roundComplete", "type": "boolean", "required": true},
        {"name": "organizerName", "type": "string", "required": true},
        {"name": "role", "type": "string", "required": true},
        {"name": "participantId", "type": "string", "required": false},
        {"name": "canRegister", "type": "boolean", "required": true},
        {"name": "participants", "type": "array", "required": true, "items": {"type": "object", "ref": "TournamentParticipantView"}},
        {"name": "pairings", "type": "array", "required": true, "items": {"type": "object", "ref": "TournamentPairingView"}},
        {"name": "standings", "type": "array", "required": true, "items": {"type": "object", "ref": "TournamentStandingView"}}
      ]
    }
