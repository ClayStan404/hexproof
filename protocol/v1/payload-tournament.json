    },
    {
      "name": "TournamentStandingView",
      "goType": "TournamentStandingView",
      "fields": [
        {"name": "rank", "type": "integer", "required": true},
        {"name": "participantId", "type": "string", "required": true},
        {"name": "displayName", "type": "string", "required": true},
        {"name": "wins", "type": "integer", "required": true},
        {"name": "losses", "type": "integer", "required": true},
        {"name": "draws", "type": "integer", "required": true},
        {"name": "matchPoints", "type": "integer", "required": true},
        {"name": "oppMatchWin", "type": "number", "required": true},
        {"name": "gameWin", "type": "number", "required": true},
        {"name": "oppGameWin", "type": "number", "required": true},
        {"name": "byes", "type": "integer", "required": true},
        {"name": "dropped", "type": "boolean", "required": true}
      ]
    }
  ],
  "messages": [
    {"type": "tournament.list", "direction": "clientToServer", "goType": "EmptyPayload", "fields": []},
    {
      "type": "tournament.listed",
      "direction": "serverToClient",
      "goType": "TournamentListed",
      "fields": [
        {"name": "tournaments", "type": "array", "required": true, "items": {"type": "object", "ref": "TournamentListEntry"}}
      ]
    },
    {
      "type": "tournament.create",
      "direction": "clientToServer",
      "goType": "TournamentCreate",
      "fields": [
        {"name": "name", "type": "string", "required": true},
        {"name": "format", "type": "string", "required": true},
        {"name": "matchMode", "type": "string", "required": true, "enum": ["MatchBO1", "MatchBO3"]},
