    {
      "type": "tournament.unregistered",
      "direction": "serverToClient",
      "goType": "TournamentChanged",
      "fields": [{"name": "tournamentId", "type": "string", "required": true}]
    },
    {
      "type": "tournament.check_in",
      "direction": "clientToServer",
      "goType": "TournamentCheckIn",
      "fields": [
        {"name": "checkedIn", "type": "boolean", "required": true},
        {"name": "participantId", "type": "string", "required": false}
      ]
