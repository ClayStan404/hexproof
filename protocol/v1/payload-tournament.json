        {"name": "plannedRounds", "type": "integer", "required": false}
      ]
    },
    {
      "type": "tournament.created",
      "direction": "serverToClient",
      "goType": "TournamentCreated",
      "fields": [
        {"name": "tournamentId", "type": "string", "required": true},
        {"name": "organizerToken", "type": "string", "required": true}
      ]
    },
    {
      "type": "tournament.enter",
      "direction": "clientToServer",
      "goType": "TournamentEnter",
      "fields": [
        {"name": "tournamentId", "type": "string", "required": true},
        {"name": "credential", "type": "string", "required": false}
      ]
