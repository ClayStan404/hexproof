{
  "schemaVersion": 1,
  "protocol": "hexproof.v1",
  "definitions": [
    {
      "name": "TournamentListEntry",
      "goType": "TournamentListEntry",
      "fields": [
        {"name": "tournamentId", "type": "string", "required": true},
        {"name": "name", "type": "string", "required": true},
        {"name": "format", "type": "string", "required": true},
        {"name": "matchMode", "type": "string", "required": true, "enum": ["MatchBO1", "MatchBO3"]},
        {"name": "status", "type": "string", "required": true},
        {"name": "registered", "type": "integer", "required": true},
        {"name": "checkedIn", "type": "integer", "required": true},
        {"name": "maxPlayers", "type": "integer", "required": true},
        {"name": "currentRound", "type": "integer", "required": true},
        {"name": "plannedRounds", "type": "integer", "required": true},
        {"name": "registrationOpen", "type": "boolean", "required": true}
      ]
    },
    {
      "name": "TournamentDeckView",
      "goType": "TournamentDeckView",
      "fields": [
        {"name": "name", "type": "string", "required": true},
        {"name": "format", "type": "string", "required": true, "enum": ["FormatModern", "FormatDuel", "FormatEDH"]},
        {"name": "commander", "type": "string", "required": false},
        {"name": "commanders", "type": "array", "required": false, "items": {"type": "string"}},
        {"name": "mainboard", "type": "array", "required": true, "items": {"type": "object", "ref": "DeckCard"}},
        {"name": "sideboard", "type": "array", "required": true, "items": {"type": "object", "ref": "DeckCard"}}
      ]
    },
    {
      "name": "TournamentParticipantView",
      "goType": "TournamentParticipantView",
      "fields": [
        {"name": "participantId", "type": "string", "required": true},
        {"name": "displayName", "type": "string", "required": true},
        {"name": "checkedIn", "type": "boolean", "required": true},
        {"name": "competing", "type": "boolean", "required": true},
        {"name": "dropped", "type": "boolean", "required": true},
        {"name": "online", "type": "boolean", "required": true},
        {"name": "deck", "type": "object", "required": false, "ref": "TournamentDeckView", "goType": "*TournamentDeckView"}
      ]
    },
    {
      "name": "TournamentPairingView",
      "goType": "TournamentPairingView",
      "fields": [
        {"name": "pairingId", "type": "string", "required": true},
        {"name": "table", "type": "integer", "required": true},
        {"name": "playerAId", "type": "string", "required": true},
        {"name": "playerAName", "type": "string", "required": true},
        {"name": "playerBId", "type": "string", "required": false},
        {"name": "playerBName", "type": "string", "required": false},
        {"name": "bye", "type": "boolean", "required": true},
        {"name": "roomId", "type": "string", "required": false},
        {"name": "status", "type": "string", "required": true},
        {"name": "playerAWins", "type": "integer", "required": true},
        {"name": "playerBWins", "type": "integer", "required": true},
        {"name": "drawnGames", "type": "integer", "required": true},
        {"name": "reporterId", "type": "string", "required": false},
        {"name": "corrected", "type": "boolean", "required": false}
