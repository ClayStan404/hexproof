      "type": "tournament.registered",
      "direction": "serverToClient",
      "goType": "TournamentRegistered",
      "fields": [
        {"name": "tournamentId", "type": "string", "required": true},
        {"name": "participantId", "type": "string", "required": true},
        {"name": "participantToken", "type": "string", "required": true}
      ]
    },
    {
      "type": "tournament.unregister",
      "direction": "clientToServer",
      "goType": "TournamentParticipantCommand",
      "fields": [{"name": "participantId", "type": "string", "required": false}]
