        {
          "name": "damageAssignmentMode",
          "type": "string",
          "required": false,
          "enum": [
            "RulesDamageOrdered",
            "RulesDamageUnordered",
            "RulesDamageDivideFreely"
          ]
        },
        {
          "name": "minSelections",
          "type": "integer",
          "required": true
        },
        {
          "name": "maxSelections",
          "type": "integer",
          "required": true
        },
        {
          "name": "cancellable",
          "type": "boolean",
          "required": true
        },
        {
          "name": "minChoiceTotal",
          "type": "integer",
          "required": true
        },
        {
          "name": "maxChoiceTotal",
          "type": "integer",
          "required": true
        },
        {
          "name": "minNumber",
          "type": "integer",
          "required": true
        },
        {
          "name": "maxNumber",
          "type": "integer",
          "required": true
        }
      ]
    },
    {
      "name": "RulesRespond",
      "goType": "RulesRespond",
      "fields": [
        {
          "name": "peerBinding",
          "type": "string",
          "required": false
        },
        {
          "name": "promptId",
          "type": "integer",
          "required": true,
          "goType": "int64"
        },
        {
          "name": "responseId",
          "type": "string",
          "required": true
        },
        {
          "name": "cardIds",
          "type": "array",
          "required": false,
          "items": {
            "type": "string"
          }
        },
        {
          "name": "targetIds",
          "type": "array",
          "required": false,
          "items": {
            "type": "string"
          }
        },
        {
          "name": "assignments",
          "type": "array",
          "required": false,
          "items": {
            "type": "object",
            "ref": "RulesPromptAssignment"
          }
        },
        {
          "name": "choiceIds",
          "type": "array",
          "required": false,
          "items": {
            "type": "string"
          }
        },
        {
          "name": "orderedIds",
          "type": "array",
          "required": false,
          "items": {
            "type": "string"
          }
        },
        {
          "name": "scryPiles",
          "type": "array",
          "required": false,
          "items": {
            "type": "object",
            "ref": "RulesPromptScryPile"
          }
        },
        {
          "name": "damageOrderIds",
          "type": "array",
          "required": false,
          "items": {
            "type": "string"
          }
        },
        {
          "name": "damageAssignments",
          "type": "array",
          "required": false,
          "items": {
            "type": "object",
            "ref": "RulesPromptDamageAssignment"
          }
        },
        {
          "name": "chosenNumber",
          "type": "integer",
          "required": false,
          "goType": "*int"
        },
        {
          "name": "name",
          "type": "string",
          "required": false
        }
      ]
    }
  ],
  "messages": [
    {
      "type": "room.ai.worker",
      "goType": "RoomAIWorker",
      "direction": "serverToClient",
      "fields": [
        {
          "name": "roomId",
          "type": "string",
          "required": true
        },
        {
          "name": "source",
          "type": "string",
          "required": true,
          "enum": [
            "AISourceLocal",
            "AISourceOnline"
          ]
        },
        {
          "name": "token",
          "type": "string",
          "required": true
        }
      ]
    },
    {
      "type": "room.ai.status",
      "goType": "RoomAIStatus",
      "direction": "serverToClient",
      "fields": [
        {
          "name": "roomId",
          "type": "string",
          "required": true
        },
        {
          "name": "state",
          "type": "string",
          "required": true
        },
        {
          "name": "code",
          "type": "string",
          "required": false
        }
      ]
    },
    {
      "type": "room.ai.retry",
      "goType": "RoomAIRetry",
      "direction": "clientToServer",
      "fields": []
    },
    {
      "type": "ai.attach",
      "goType": "AIAttach",
      "direction": "clientToServer",
      "fields": [
        {
          "name": "roomId",
          "type": "string",
          "required": true
        },
        {
          "name": "token",
          "type": "string",
          "required": true
        }
      ]
    },
    {
      "type": "ai.attached",
      "goType": "AIAttached",
      "direction": "serverToClient",
      "fields": [
        {
          "name": "roomId",
          "type": "string",
          "required": true
        }
      ]
    },
    {
      "type": "ai.decision",
      "goType": "AIDecision",
      "direction": "serverToClient",
      "fields": [
        {
          "name": "requestId",
          "type": "string",
          "required": true
        },
        {
          "name": "gameId",
          "type": "string",
          "required": true
        },
        {
          "name": "seatIndex",
          "type": "integer",
          "required": true
        },
        {
          "name": "prompt",
          "type": "object",
          "required": true,
          "ref": "RulesPrompt"
        },
        {
          "name": "snapshot",
          "type": "object",
          "required": true,
          "ref": "RulesGameSnapshot"
        }
      ]
    },
    {
      "type": "ai.answer",
      "goType": "AIAnswer",
      "direction": "clientToServer",
      "fields": [
        {
          "name": "requestId",
          "type": "string",
          "required": true
        },
        {
          "name": "response",
          "type": "object",
          "required": true,
          "ref": "RulesRespond"
        }
      ]
    },
    {
      "type": "ai.failure",
      "goType": "AIFailure",
      "direction": "clientToServer",
      "fields": [
        {
          "name": "requestId",
          "type": "string",
          "required": true
        },
        {
          "name": "code",
          "type": "string",
          "required": true
        }
      ]
    },
    {
      "type": "ai.cancel",
      "goType": "AICancel",
      "direction": "serverToClient",
      "fields": [
        {
          "name": "requestId",
          "type": "string",
          "required": true
        }
      ]
    },
    {
      "type": "ai.rejected",
      "goType": "AIRejected",
      "direction": "serverToClient",
      "fields": [
        {
          "name": "requestId",
          "type": "string",
          "required": true
        },
        {
          "name": "code",
          "type": "string",
          "required": true
        }
      ]
    }
  ]
}
