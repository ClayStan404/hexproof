        {
          "name": "damageTargets",
          "type": "array",
          "required": true,
          "items": {
            "type": "object",
            "ref": "RulesPromptDamageTarget"
          }
        },
        {
          "name": "totalDamage",
          "type": "integer",
          "required": true
        },
        {
          "name": "damageDeathtouch",
          "type": "boolean",
          "required": true
