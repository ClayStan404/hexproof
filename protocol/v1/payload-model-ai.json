{
  "schemaVersion": 1,
  "protocol": "hexproof.v1",
  "definitions": [
    {
      "name": "RulesGameSnapshot",
      "goType": "RulesGameSnapshot",
      "fields": [
        {
          "name": "roomId",
          "type": "string",
          "required": true
        },
        {
          "name": "gameId",
          "type": "string",
          "required": true
        },
        {
          "name": "turn",
          "type": "integer",
          "required": true
        },
        {
          "name": "step",
          "type": "string",
          "required": true
        },
        {
          "name": "activeSeat",
          "type": "integer",
          "required": true
        },
        {
          "name": "prioritySeat",
          "type": "integer",
          "required": true
        },
        {
          "name": "players",
          "type": "array",
          "required": true,
          "items": {
            "type": "object",
            "ref": "RulesPlayerState"
          }
        },
        {
          "name": "zones",
          "type": "array",
          "required": true,
          "items": {
            "type": "object",
            "ref": "RulesZoneState"
          }
        },
        {
          "name": "stack",
          "type": "array",
          "required": true,
          "items": {
            "type": "object",
            "ref": "RulesStackObject"
          }
        },
        {
          "name": "gameOver",
          "type": "boolean",
          "required": true
        },
        {
          "name": "winnerSeat",
          "type": "integer",
          "required": false,
          "nullable": true
        }
      ]
    },
    {
      "name": "RulesPrompt",
      "goType": "RulesPrompt",
      "fields": [
        {
          "name": "roomId",
          "type": "string",
          "required": true
        },
        {
          "name": "gameId",
          "type": "string",
          "required": true
        },
        {
          "name": "pending",
          "type": "boolean",
          "required": true
        },
        {
          "name": "promptId",
          "type": "integer",
          "required": true,
          "goType": "int64"
        },
        {
          "name": "kind",
          "type": "string",
          "required": true
        },
        {
          "name": "supported",
          "type": "boolean",
          "required": true
        },
        {
          "name": "autoPassEligible",
          "type": "boolean",
          "required": false
        },
        {
          "name": "title",
          "type": "string",
          "required": true
        },
        {
          "name": "detail",
          "type": "string",
          "required": true
        },
        {
          "name": "options",
          "type": "array",
          "required": true,
          "items": {
            "type": "object",
            "ref": "RulesPromptOption"
          }
        },
        {
          "name": "choices",
          "type": "array",
          "required": true,
          "items": {
            "type": "object",
            "ref": "RulesPromptChoice"
          }
        },
        {
          "name": "cards",
          "type": "array",
          "required": true,
          "items": {
            "type": "object",
            "ref": "RulesPromptCard"
          }
        },
        {
          "name": "scryDestinations",
          "type": "array",
          "required": true,
          "items": {
            "type": "string"
          }
        },
        {
          "name": "orderItems",
          "type": "array",
          "required": true,
          "items": {
            "type": "object",
            "ref": "RulesPromptOrderItem"
          }
        },
        {
          "name": "contextCards",
          "type": "array",
          "required": true,
          "items": {
            "type": "object",
            "ref": "RulesPromptCard"
          }
        },
        {
          "name": "contextTargets",
          "type": "array",
          "required": true,
          "items": {
            "type": "object",
            "ref": "RulesPromptTarget"
          }
        },
        {
          "name": "contextText",
          "type": "string",
          "required": true
        },
        {
          "name": "requiredSelections",
          "type": "integer",
          "required": true
        },
        {
          "name": "minCardSelections",
          "type": "integer",
          "required": true
        },
        {
          "name": "maxCardSelections",
          "type": "integer",
          "required": true
        },
        {
          "name": "targets",
          "type": "array",
          "required": true,
          "items": {
            "type": "object",
            "ref": "RulesPromptTarget"
          }
        },
        {
          "name": "combatSources",
          "type": "array",
          "required": true,
          "items": {
            "type": "object",
            "ref": "RulesPromptCombatSource"
          }
        },
        {
          "name": "combatTargets",
          "type": "array",
          "required": true,
          "items": {
            "type": "object",
            "ref": "RulesPromptCombatTarget"
          }
        },
        {
          "name": "damageSource",
          "type": "object",
          "required": false,
          "ref": "RulesPromptDamageSource",
          "goType": "*RulesPromptDamageSource"
