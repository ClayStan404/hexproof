{
  "schemaVersion": 1,
  "protocol": "hexproof.v1",
  "definitions": [
    {
      "name": "ReplayRulesSnapshot",
      "goType": "RulesGameSnapshot",
      "fields": [
        {
          "name": "roomId",
          "type": "string",
          "required": true
        },
        {
          "name": "gameId",
          "type": "string",
          "required": true
        },
        {
          "name": "turn",
          "type": "integer",
          "required": true
        },
        {
          "name": "step",
          "type": "string",
          "required": true
        },
        {
          "name": "activeSeat",
          "type": "integer",
          "required": true
        },
        {
          "name": "prioritySeat",
          "type": "integer",
          "required": true
        },
        {
          "name": "players",
          "type": "array",
          "required": true,
          "items": {
            "type": "object",
            "ref": "RulesPlayerState"
          }
        },
        {
          "name": "zones",
          "type": "array",
          "required": true,
          "items": {
            "type": "object",
            "ref": "RulesZoneState"
          }
        },
        {
          "name": "stack",
          "type": "array",
          "required": true,
          "items": {
            "type": "object",
            "ref": "RulesStackObject"
          }
        },
        {
          "name": "gameOver",
          "type": "boolean",
          "required": true
        },
        {
          "name": "winnerSeat",
          "type": "integer",
          "required": false,
          "nullable": true
        }
      ]
    },
    {
      "name": "ForgeReplayRelation",
      "goType": "ForgeReplayRelation",
      "fields": [
        {
          "name": "kind",
          "type": "string",
          "required": true
        },
        {
          "name": "sourceId",
          "type": "string",
          "required": true
        },
        {
          "name": "targetId",
          "type": "string",
          "required": false
        },
        {
          "name": "targetSeat",
          "type": "integer",
          "required": false,
          "goType": "*int"
        }
      ]
    },
    {
      "name": "ForgeReplayFrame",
      "goType": "ForgeReplayFrame",
      "fields": [
        {
          "name": "sequence",
          "type": "integer",
          "required": true,
          "goType": "int64"
        },
        {
          "name": "elapsedMs",
          "type": "integer",
          "required": true,
          "goType": "int64"
        },
        {
          "name": "gameNumber",
          "type": "integer",
          "required": true
        },
        {
          "name": "kind",
          "type": "string",
          "required": true
        },
        {
          "name": "actorSeat",
          "type": "integer",
          "required": true
        },
        {
          "name": "text",
          "type": "string",
          "required": true
        },
        {
          "name": "snapshot",
          "type": "object",
          "required": true,
          "ref": "ReplayRulesSnapshot",
          "goType": "RulesGameSnapshot"
        },
        {
          "name": "combat",
          "type": "array",
          "required": true,
          "items": {
            "type": "object",
            "ref": "ForgeReplayRelation"
          }
        }
      ]
    }
  ],
  "messages": [
    {
      "type": "replay.forge_grant",
      "goType": "ForgeReplayGrant",
      "direction": "serverToClient",
      "fields": [
        {
          "name": "replayId",
          "type": "string",
          "required": true
        },
        {
          "name": "token",
          "type": "string",
          "required": true
        },
        {
          "name": "roomName",
          "type": "string",
          "required": true
        },
        {
          "name": "format",
          "type": "string",
          "required": true
        },
        {
          "name": "matchMode",
          "type": "string",
          "required": true
        },
        {
          "name": "players",
          "type": "array",
          "required": true,
          "items": {
            "type": "string"
          }
        },
        {
          "name": "finished",
          "type": "boolean",
          "required": true
        },
        {
          "name": "complete",
          "type": "boolean",
          "required": true
        },
        {
          "name": "frameCount",
          "type": "integer",
          "required": true
        },
        {
          "name": "expiresAt",
          "type": "string",
          "required": true
        }
      ]
    },
    {
      "type": "replay.forge_get",
      "goType": "ForgeReplayGet",
      "direction": "clientToServer",
      "fields": [
        {
          "name": "replayId",
          "type": "string",
          "required": true
        },
        {
          "name": "token",
          "type": "string",
          "required": true
        },
        {
          "name": "offset",
          "type": "integer",
          "required": true
        }
      ]
    },
    {
      "type": "replay.forge_page",
      "goType": "ForgeReplayPage",
      "direction": "serverToClient",
      "fields": [
        {
          "name": "replayId",
          "type": "string",
          "required": true
        },
        {
          "name": "schemaVersion",
          "type": "integer",
          "required": true
        },
        {
          "name": "offset",
          "type": "integer",
          "required": true
        },
        {
          "name": "total",
          "type": "integer",
          "required": true
        },
        {
          "name": "complete",
          "type": "boolean",
          "required": true
        },
        {
          "name": "frames",
          "type": "array",
          "required": true,
          "items": {
            "type": "object",
            "ref": "ForgeReplayFrame"
          }
        }
      ]
    }
  ]
}
