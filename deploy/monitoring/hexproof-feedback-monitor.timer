[Unit]
Description=Collect Hexproof public-feedback readiness every 30 seconds

[Timer]
OnBootSec=30s
OnUnitInactiveSec=30s
AccuracySec=1s
Unit=hexproof-feedback-monitor.service

[Install]
WantedBy=timers.target
